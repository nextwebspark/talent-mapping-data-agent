# Supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=eyJ...service-role-key...

# Gemini (AI Studio key for local dev). For Vertex AI runtime, use GOOGLE_CLOUD_PROJECT + GOOGLE_CLOUD_LOCATION instead.
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false

# Vertex AI (used by deploy + production runs)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GCS_STAGING_BUCKET=gs://your-staging-bucket

# Model + prompt
ENRICHMENT_MODEL=gemini-2.5-pro
PROMPT_VERSION=v1
